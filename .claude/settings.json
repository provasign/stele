{
  "enabledMcpjsonServers": [
    "prism"
  ],
  "hooks": {
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "command": "stele hook",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash"
      },
      {
        "hooks": [
          {
            "command": "stele hook",
            "timeout": 12,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "stele hook",
            "timeout": 6,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "stele hook",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "stele hook",
            "timeout": 6,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(stele change:*)",
      "Bash(stele adopt:*)",
      "Bash(stele keep:*)",
      "Bash(stele gate:*)",
      "Bash(stele check:*)",
      "Bash(stele sync:*)",
      "Bash(stele rules:*)",
      "Bash(stele touches:*)"
    ]
  }
}
