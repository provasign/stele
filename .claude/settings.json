{
  "enabledMcpjsonServers": [
    "prism"
  ],
  "hooks": {
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stele-hook.js\"",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash"
      },
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stele-hook.js\"",
            "timeout": 12,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stele-hook.js\"",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "command -v shale >/dev/null 2>&1 && shale capture claude-code || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stele-hook.js\"",
            "timeout": 6,
            "type": "command"
          }
        ]
      }
    ]
  }
}
